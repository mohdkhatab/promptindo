{
  "name": "promptindo-functions",
  "version": "1.0.0",
  "description": "PromptIndo Cloud Functions (counters, notifications, moderation, admin)",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  },
  "private": true
}
