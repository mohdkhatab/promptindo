# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for Supabase pg_net -> Next.js webhooks (>= 32 random bytes, matches Vault secret `webhook_secret`)
WEBHOOK_SECRET=replace-with-at-least-32-random-bytes-secret

# Firebase Admin SDK service-account JSON encoded as base64 (used ONLY for FCM push)
# Generate: base64 -w 0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-encoded-service-account-json

# Public canonical URL of this Next.js deployment (no trailing slash)
SITE_URL=https://www.promptindo.app

# Appwrite media storage (server-only, never expose to the Flutter app)
APPWRITE_ENDPOINT=https://tor.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your-appwrite-project-id
APPWRITE_BUCKET_ID=your-media-bucket-id
APPWRITE_API_KEY=your-appwrite-server-api-key
