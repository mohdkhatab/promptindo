rules_version = '2';

//
// PromptIndo — Cloud Storage rules.
//
// avatars/{uid}/{file}      → only the owner may write their own avatar
// thumbnails/{folder}/{file}→ any signed-in user may upload a prompt
//                              thumbnail (the folder is the uploader's uid or
//                              the prompt id); only the owner/admin may delete
//
// Note: Storage rules validate type + size but do NOT strip EXIF. The Flutter
// client re-encodes/compresses images (flutter_image_compress) before upload,
// which also strips EXIF — see README "EXIF handling".
//
service firebase.storage {
  match /b/{bucket}/o {

  function signedIn() {
    return request.auth != null;
  }

  function isAdmin() {
    return signedIn() && request.auth.token.role == 'admin';
  }

  function isImage() {
    return request.resource.contentType.matches('image/.*');
  }

  function isSafeImageName() {
    return fileName.matches('.*\\.(jpg|jpeg|png|webp)$');
  }

    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && isImage()
        && isSafeImageName();
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /thumbnails/{folder}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && folder == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && isImage()
        && isSafeImageName();
      allow delete: if signedIn() && (folder == request.auth.uid || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
